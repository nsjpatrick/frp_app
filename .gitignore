# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Superpowers brainstorming artifacts
.superpowers/
test-results/

# JobCalc analysis artifacts — regenerated by scripts/inspect-jobcalc.ts
/scripts/jobcalc-dump/

# HTD analysis artifacts — regenerated by scripts/inspect-htd.ts
/scripts/htd-dump/

# Engineering source workbooks. The pricing engine bakes the relevant
# constants into source files; the workbooks stay on the engineering
# share rather than in the repo.
/HTD Tank Heat Loss Program_ver*.xlsx
/jobcalc*.xls*
